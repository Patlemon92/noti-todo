    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vite-plugin-pwa": "^0.20.5"
  }
